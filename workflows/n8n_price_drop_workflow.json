{
  "name": "TechBoy Price Drop Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "techboy-price-drop",
        "options": {}
      },
      "id": "e98e727e-8bf0-410e-8f59-586b3a0e6981",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "fromEmail": "techboy-alerts@yoursite.com",
        "toEmail": "={{ Array.isArray($json.body.target_emails) ? $json.body.target_emails.join(',') : $json.body.target_emails }}",
        "subject": "=Price Drop: {{ $json.body.product_name }} is now Rs {{ $json.body.new_price }}",
        "html": "=<div style=\"font-family:Arial,sans-serif;background:#0d0d0d;color:#f5f5f5;padding:24px\"><div style=\"max-width:620px;margin:auto;background:#160407;border:1px solid #ff1f3d;border-radius:16px;padding:28px\"><h1 style=\"color:#ff1f3d\">TECHBOY STORE</h1><h2>Price drop detected</h2><p><strong>{{ $json.body.product_name }}</strong> just dropped in price.</p><p>Old price: <strong>Rs {{ $json.body.old_price }}</strong></p><p>New price: <strong style=\"color:#ff6d7d\">Rs {{ $json.body.new_price }}</strong></p><p>You save: <strong>Rs {{ $json.body.discount_amount }}</strong></p><p>Open TechBoy Store and grab the deal before it changes.</p></div></div>",
        "options": {}
      },
      "id": "99f6bba8-7ddf-44f6-8c44-b0ecf79c299c",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [520, 300]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
